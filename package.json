{
  "name": "uro-info",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && pnpm typecheck:worker",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "deploy": "wrangler deploy",
    "format": "prettier --write \"**/*.{ts,tsx,js,mdx,md,json,css}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mdx,md,json,css}\" --cache"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20250109.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "wrangler": "^4.20.0"
  }
}
